        "tipo": {
          "enum": [
            "entrada", "colocacao", "turno", "movimento", "ataque", "dano", "cura", "estado", "desgraca", "reacao", "consumivel", "ambiente", "revertido", "recomeco", "escala", "fim", "raio", "dano_ambiente", "fogo",
            "pausa", "retomada", "cartao", "cartao_fechado", "lobby", "modo", "ia", "recusa", "acao", "teste_morte", "erro_motor", "ambiente_mestre", "aviso_motor"
          ]
        },
        "dados": {
