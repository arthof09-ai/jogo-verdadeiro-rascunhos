{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MASTER_LOBBY_SET.schema.json",
  "title": "MASTER_LOBBY_SET (Mestre → servidor)",
  "description": "§5: prepara a sessão; nada aparece às jogadoras. Todo MASTER_* que muda estado leva cmdId (idempotência) e revision (E-C3).",
  "type": "object",
  "required": ["v", "type", "roomId", "cmdId", "revision"],
  "properties": {
    "v": { "$ref": "comum.schema.json#/$defs/v" },
    "type": { "const": "MASTER_LOBBY_SET" },
    "roomId": { "$ref": "comum.schema.json#/$defs/roomId" },
    "cmdId": { "$ref": "comum.schema.json#/$defs/idOpaco" },
    "revision": { "$ref": "comum.schema.json#/$defs/revision" },
    "mapaId": { "type": ["string", "null"], "maxLength": 64 },
    "criaturasDisponiveis": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "npcsDisponiveis": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
  },
  "additionalProperties": false
}
