{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MASTER_PAUSE.schema.json",
  "title": "MASTER_PAUSE (Mestre → servidor)",
  "description": "E-C13 (comando novo). O servidor pausa com o motivo 'manutencao' e envia ROOM_PAUSED a todos.",
  "type": "object",
  "required": ["v", "type", "roomId", "cmdId", "revision"],
  "properties": {
    "v": { "$ref": "comum.schema.json#/$defs/v" },
    "type": { "const": "MASTER_PAUSE" },
    "roomId": { "$ref": "comum.schema.json#/$defs/roomId" },
    "cmdId": { "$ref": "comum.schema.json#/$defs/idOpaco" },
    "revision": { "$ref": "comum.schema.json#/$defs/revision" }
  },
  "additionalProperties": false
}
